@startuml
!include _style.iuml
start
:Load UCI dataset (299 patients);
:Expand to 2000 records\n(jitter continuous features,\nflip 5% binary values and labels);
:Assign source_id to every record;
:Group-aware 70/30 split\n(GroupShuffleSplit on source_id);
fork
  :Logistic Regression;
fork again
  :SVM (calibrated);
fork again
  :Decision Tree;
fork again
  :Random Forest;
fork again
  :XGBoost\n+ GridSearchCV (F1);
fork again
  :Gradient Boosting;
end fork
:5-fold StratifiedGroupKFold CV\non training split;
:Evaluate on held-out test set\n(accuracy, precision, recall, F1, ROC-AUC);
:Plot confusion matrices,\nROC curves, feature importance;
:Export XGBoost pipeline\n(model.joblib + model_meta.json);
stop
@enduml
